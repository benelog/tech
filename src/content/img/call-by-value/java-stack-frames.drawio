<mxfile host="app.diagrams.net">
  <diagram id="java-stack-frames" name="Java stack frames">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="540">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- regions -->
        <mxCell id="stack" value="JVM stack (main thread)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fafafa;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="440" height="460" as="geometry" />
        </mxCell>
        <mxCell id="heap" value="Heap" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fafafa;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="20" width="320" height="460" as="geometry" />
        </mxCell>

        <!-- reassign frame -->
        <mxCell id="f2" value="Frame of reassign (current frame)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="f2lbl" value="Local variable array" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="92" width="160" height="24" as="geometry" />
        </mxCell>
        <mxCell id="t0i" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t0" value="targetTv" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- main frame -->
        <mxCell id="f1" value="Frame of main (caller)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f1lbl" value="Local variable array" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="332" width="160" height="24" as="geometry" />
        </mxCell>
        <mxCell id="m0i" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m0" value="args" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="360" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m1i" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="myTv" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- objects -->
        <mxCell id="rock" value="Tv object&lt;br&gt;channel = &quot;Rock&quot;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="classic" value="Tv object&lt;br&gt;channel = &quot;Classic&quot;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="700" y="390" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e_copy" value="① Reference value copied&lt;br&gt;(via the operand stack)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontColor=#6c8ebf;strokeColor=#6c8ebf;dashed=1;strokeWidth=1.5;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#fafafa;" edge="1" parent="1" source="m1" target="t0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="408" />
              <mxPoint x="340" y="245" />
              <mxPoint x="190" y="245" />
            </Array>
            <mxPoint as="offset" x="0" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_old" value="Before reassignment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontColor=#999999;strokeColor=#b3b3b3;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;labelBackgroundColor=#fafafa;" edge="1" parent="1" source="t0" target="classic">
          <mxGeometry x="0.25" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="152" />
              <mxPoint x="620" y="405" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_new" value="② targetTv = new Tv();&lt;br&gt;targetTv.setChannel(&quot;Rock&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#d79b00;fontColor=#b46504;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t0" target="rock">
          <mxGeometry x="0.3" relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-26" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_mytv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=1.5;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.6667;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="classic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- caption -->
        <mxCell id="note" value="A static method receives its parameters starting at local variable 0 (JVMS §2.6.1). The slots in the two frames are separate variables." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="490" width="940" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
